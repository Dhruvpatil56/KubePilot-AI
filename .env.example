# ─────────────────────────────────────────
# KubePilot AI — Environment Variables
# ─────────────────────────────────────────
# Copy this file:
#   cp .env.example .env
#
# Then fill in your values.
# NEVER commit .env to git — it is gitignored.
#
# For Kubernetes deployments, do NOT use .env at all.
# Instead pass your key via environment variable:
#   export GROQ_API_KEY=gsk_your_key_here
#   ./setup.sh
# The setup script stores it in a K8s Secret automatically.
# ─────────────────────────────────────────

# ── LLM Provider ─────────────────────────
# Options: groq | openai | bedrock | ollama
LLM_PROVIDER=groq

# Groq (default — free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional — set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AWS Bedrock (optional — uses IAM, no key needed)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# Ollama (optional — local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3

# ── Agent Safety ──────────────────────────
DRY_RUN=true                   # set false to execute real K8s actions
ENABLE_AUTO_REMEDIATION=true
CONFIDENCE_THRESHOLD=0.7       # 0.0 to 1.0
ESCALATION_THRESHOLD=3         # failures before pod is suppressed

# ── Kubernetes ────────────────────────────
K8S_NAMESPACE=sre-demo

# ── Storage ───────────────────────────────
DB_PATH=/data/kubepilot.db     # falls back to ./kubepilot.db if /data/ missing

# ── GitOps (optional) ─────────────────────
# Set GITOPS_MODE=true to create GitHub PRs instead of direct K8s changes
GITOPS_MODE=false
GITHUB_TOKEN=
GITHUB_REPO=your_username/KubePilot-AI
ARGOCD_URL=
ARGOCD_TOKEN=

# ── Slack (optional) ──────────────────────
# Get token at api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
